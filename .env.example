# TeamAir AI Growth Engine - Environment Configuration
# Copy this file to .env and fill in your values

# AI Model Configuration
OPENAI_API_KEY=sk-your-openai-key-here
PRIMARY_MODEL=openai/gpt-4.1

# Telnyx SMS Configuration
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_PHONE_NUMBER=+18606199787
TELNYX_MESSAGING_PROFILE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# AgentMail Email Configuration
AGENTMAIL_API_KEY=am_xxxxxxxxxxxxxxxx
AGENTMAIL_EMAIL=yourname@agentmail.to

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Webhook Configuration
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=your-webhook-secret-for-verification

# Business Configuration
BUSINESS_TIMEZONE=America/New_York
AUTO_RESPOND=true
FOLLOW_UP_ENABLED=true

# Optional Integrations
# GOOGLE_CLIENT_ID=xxx
# GOOGLE_CLIENT_SECRET=xxx
# SLACK_WEBHOOK_URL=https://hooks.slack.com/xxx
